{
  "name": "sgmfoundry-mtc",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "dev": "next dev --webpack",
    "build": "next build",
    "preview": "npm run build && wrangler dev",
    "typecheck": "tsc --noEmit -p tsconfig.json && tsc -p tsconfig.worker.json",
    "lint": "eslint",
    "db:init": "wrangler d1 execute sgm-mtc --remote --file=./migrations/0001_init.sql",
    "deploy": "npm run build && wrangler deploy",
    "verify:print": "node scripts/verify-print.mjs"
  },
  "dependencies": {
    "@fontsource/ibm-plex-mono": "^5.3.0",
    "@fontsource/inter": "^5.3.0",
    "@fontsource/source-serif-4": "^5.3.0",
    "clsx": "^2.1.1",
    "next": "16.2.11",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "tailwind-merge": "^3.6.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20261104.1",
    "@playwright/test": "^1.61.1",
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.2.11",
    "playwright-core": "^1.61.1",
    "tailwindcss": "^4",
    "typescript": "^5",
    "wrangler": "^4.157.0"
  }
}
